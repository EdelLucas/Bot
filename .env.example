# --- Discord ---
# Bot-Token aus dem Discord Developer Portal (Bot -> Reset Token)
DISCORD_TOKEN=
# Application ID (General Information -> Application ID)
DISCORD_CLIENT_ID=
# Server-ID. Wenn gesetzt, werden die Commands nur dort (sofort) registriert.
# Leer lassen = global registrieren (kann bis zu 1 Stunde dauern).
DISCORD_GUILD_ID=
# Kanal, in dem Events angekündigt werden (kann pro Event überschrieben werden)
ANKUENDIGUNG_KANAL_ID=
# Optional: Rollen-ID, die Events & Auszahlungen verwalten darf
# (zusätzlich zu allen mit der Berechtigung "Server verwalten")
ADMIN_ROLE_ID=

# --- Google Sheets ---
# Die ID steht in der Sheet-URL: https://docs.google.com/spreadsheets/d/<HIER>/edit
GOOGLE_SHEET_ID=
# Service-Account-Zugang: ENTWEDER Pfad zur JSON-Datei ...
GOOGLE_CREDENTIALS_FILE=./credentials.json
# ... ODER den kompletten JSON-Inhalt in eine Zeile (z.B. für Hosting ohne Dateien)
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}

# --- Auszahlung ---
# Wie lange muss man mindestens im Call sein (in % der Eventdauer)?
# Kann pro Event mit "min_minuten" überschrieben werden.
MIN_ANWESENHEIT_PROZENT=50
WAEHRUNG=$
ZEITZONE=Europe/Berlin
# Datei, in der die laufende Call-Erfassung zwischengespeichert wird (übersteht Neustarts)
TRACKING_DATEI=data/tracking.json
