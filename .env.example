# --- Discord ---
# Bot-Token aus dem Discord Developer Portal (Bot -> Reset Token)
DISCORD_TOKEN=
# Application ID (General Information -> Application ID)
DISCORD_CLIENT_ID=
# Optional: Server-ID. Wenn gesetzt, werden die Commands nur dort (sofort) registriert.
# Leer lassen = global registrieren (kann bis zu 1 Stunde dauern).
DISCORD_GUILD_ID=

# --- Google Sheets ---
# Die ID steht in der Sheet-URL: https://docs.google.com/spreadsheets/d/<HIER>/edit
GOOGLE_SHEET_ID=
# Name des Tabellenblatts (Tab unten im Sheet)
GOOGLE_SHEET_TAB=Einträge
# Service-Account-Zugang: ENTWEDER Pfad zur JSON-Datei ...
GOOGLE_CREDENTIALS_FILE=./credentials.json
# ... ODER den kompletten JSON-Inhalt in eine Zeile (z.B. für Hosting ohne Dateien)
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}

# Optional: Discord-Rollen-ID, deren Mitglieder fremde Einträge löschen dürfen
# (zusätzlich zu allen mit der Berechtigung "Nachrichten verwalten")
ADMIN_ROLE_ID=
