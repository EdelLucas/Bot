# --- Discord (Pflicht) ---
# Bot-Token aus dem Discord Developer Portal (Bot -> Reset Token). NIEMALS teilen!
DISCORD_TOKEN=
# Application ID (General Information -> Application ID)
DISCORD_CLIENT_ID=

# --- Google (Pflicht) ---
# Den Dienstkonto-Schlüssel als JSON-Datei in den Hauptordner legen (Name egal, z.B. credentials.json)
# ODER den kompletten JSON-Inhalt in eine Zeile:
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}

# --- Optional ---
# Sheet, Ankündigungskanal und Admin-Rolle stellt jeder Server selbst mit /setup ein.
# Diese Werte sind nur eine Vorgabe für EINEN Server (DISCORD_GUILD_ID):
DISCORD_GUILD_ID=
ANKUENDIGUNG_KANAL_ID=
ADMIN_ROLE_ID=

# Wie lange muss man mindestens im Call sein (in % der Eventdauer)?
# Kann pro Event mit "min_minuten" überschrieben werden.
MIN_ANWESENHEIT_PROZENT=50
WAEHRUNG=$
ZEITZONE=Europe/Berlin
# Slash-Commands bei jedem Start automatisch registrieren
COMMANDS_AUTOMATISCH_REGISTRIEREN=true
